# Google Gemini API key (set here or in Studio settings)
# GEMINI_API_KEY=your-gemini-api-key

# Anthropic API key (optional alternative)
# ANTHROPIC_API_KEY=sk-ant-...

# Provider: auto (legacy key priority), gemini, or anthropic
AUTONOVEL_PROVIDER=auto

# Writer model (used for drafting, revision, planning)
AUTONOVEL_WRITER_MODEL=gemini-2.5-pro

# Judge model (used for evaluation, adversarial cuts, tournament)
AUTONOVEL_JUDGE_MODEL=gemini-2.5-pro

# Review model (deep prose-level analysis, used in Phase 3b)
AUTONOVEL_REVIEW_MODEL=gemini-2.5-pro

# Optional fal.ai key for image generation (Nano Banana 2)
FAL_KEY=your-fal-api-key-here

# Optional ElevenLabs API key for audiobook generation
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
